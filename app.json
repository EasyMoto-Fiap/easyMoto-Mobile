{
  "expo": {
    "name": "EasyMotoTS",
    "slug": "EasyMotoTS",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.easymoto.fiap",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAj1UuC2IMPH8KKIpt_20l8GyKOBymN9KA"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "notification": {
      "icon": "./assets/favicon.png",
      "color": "#00C853"
    },
    "extra": {
      "API_URL": "http://74.249.100.243",
      "API_KEY": "super-secret-key",
      "eas": {
        "projectId": "b0be3891-b078-46a1-a72f-a380c1c53547"
      }
    },
    "owner": "akemisky"
  }
}
